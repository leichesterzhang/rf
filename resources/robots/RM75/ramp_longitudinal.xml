<mujoco model="RM75 longitudinal ramp">
  <include file="RM75.xml"/>

  <statistic center="5 0 0.4" extent="5"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-135" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
  </asset>

  <worldbody>
    <light pos="4 0 5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 3 m ascent at 12 degrees, 2 m plateau, then a matching descent. -->
    <geom name="uphill" type="box" pos="2.5 0 0.31884" size="1.5 10 0.05"
          quat="0.994521895 0 -0.104528463 0"/>
    <geom name="summit" type="box" pos="5 0 0.63768" size="1 10 0.05"/>
    <geom name="downhill" type="box" pos="7.5 0 0.31884" size="1.5 10 0.05"
          quat="0.994521895 0 0.104528463 0"/>
  </worldbody>
</mujoco>
